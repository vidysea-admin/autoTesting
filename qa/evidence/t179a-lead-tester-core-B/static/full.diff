+++ b/src/autotester/agents/tools.py
@@ -0,0 +1,184 @@
+"""The lead tester's stage tools and their one dispatcher (T-179, AL2/AL3/AL6).
+
+Every tool body is a thin call into the existing stage function named by its `ToolSpec.wraps`
+(C3: nothing re-implemented). `dispatch` is the only entry a model reaches: it runs the secret
+gate on the raw call, validates the tool name and arguments, lets the tool run its guards
+(`agents/guards.py`) BEFORE any browser opens, and releases a scrubbed, re-gated outcome. A
+refusal comes back as a `ToolOutcome`, never as something the model can argue with.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from typing import Any
+
+from pydantic import BaseModel, ValidationError
+
+from autotester.agents import guards
+from autotester.agents.context import AgentContext
+from autotester.browser.observe import PageObserver
+from autotester.core.consent import ApprovalRequired
+from autotester.schema.agent_layer import (
+    AgentToolName as Name,
+)
+from autotester.schema.agent_layer import (
+    CrawlArgs,
+    EmptyArgs,
+    GradeCaseArgs,
+    RefusalClass,
+    RunCaseArgs,
+    ToolEffect,
+    ToolOutcome,
+    ToolSpec,
+)
+from autotester.schema.crawl import CrawlBounds
+from autotester.schema.run import RawResult
+from autotester.stages import catalog, execute, explore, grade
+
+_PERSONA = "autotester.store.project_store.ProjectStore.load_portal_persona"
+TOOLS: dict[Name, ToolSpec] = {
+    Name.CRAWL: ToolSpec(
+        name=Name.CRAWL, effect=ToolEffect.ACTING, wraps="autotester.stages.explore.run_crawl",
+        description="Bounded crawl of the project; needs a covering approval."),
+    Name.RUN_CASE: ToolSpec(
+        name=Name.RUN_CASE, effect=ToolEffect.ACTING, wraps="autotester.stages.execute.run_case",
+        description="Execute one stored case in the browser; observes only."),
+    Name.GET_PERSONA: ToolSpec(
+        name=Name.GET_PERSONA, effect=ToolEffect.READ, wraps=_PERSONA,
+        description="Read the durable portal persona."),
+    Name.GET_CATALOG: ToolSpec(
+        name=Name.GET_CATALOG, effect=ToolEffect.READ, wraps="autotester.stages.catalog.catalog",
+        description="Read which case classes can run, and what blocks the rest."),
+    Name.GRADE_CASE: ToolSpec(
+        name=Name.GRADE_CASE, effect=ToolEffect.GRADING, wraps="autotester.stages.grade.grade",
+        description="Judge one executed case in a fresh context."),
+}
+_ARGS: dict[Name, type[BaseModel]] = {
+    Name.CRAWL: CrawlArgs, Name.RUN_CASE: RunCaseArgs, Name.GET_PERSONA: EmptyArgs,
+    Name.GET_CATALOG: EmptyArgs, Name.GRADE_CASE: GradeCaseArgs,
+}
+
+
+class _Refused(Exception):
+    def __init__(self, kind: RefusalClass, detail: str) -> None:
+        super().__init__(detail)
+        self.kind, self.detail = kind, detail
+
+
+def _refusal(tool: str, kind: RefusalClass, detail: str) -> ToolOutcome:
+    return ToolOutcome(tool=tool, ok=False, refusal=kind, summary=detail)
+
+
+def _crawl(ctx: AgentContext, args: CrawlArgs) -> ToolOutcome:
+    asked = {"max_actions": args.max_actions, "wall_clock_s": args.wall_clock_s}
+    bounds = CrawlBounds(**{k: v for k, v in asked.items() if v is not None})
+    guards.crawl_approval(ctx.store, ctx.project, bounds)
+    observer = PageObserver()
+    login = ctx.store.get_case(ctx.project.login_case_id) if ctx.project.login_case_id else None
+    with ctx.open_session(observer) as session:
+        crawl = explore.run_crawl(ctx.project, session, ctx.store, observer=observer,
+                                  bounds=bounds, login_case=login, incremental=args.incremental)
+    return ToolOutcome(tool="crawl", ok=True, artifact_ref=f"crawl:{crawl.id}",
+                       summary=f"{crawl.status.value}: {crawl.screens} screens, "
+                               f"{crawl.actions} actions")
+
+
+def _scrubbed(ctx: AgentContext, result: RawResult) -> RawResult:
+    """Persist and return only scrubbed text (C5), whatever the stage let through."""
+    cleaned = ctx.secrets.redactor().scrub_obj(result.model_dump(mode="json"))
+    return RawResult.model_validate(cleaned)
+
+
+def _run_case(ctx: AgentContext, args: RunCaseArgs) -> ToolOutcome:
+    case = ctx.store.get_case(args.case_id)
+    if case is None or not case.steps:
+        raise _Refused(RefusalClass.NOTHING_TO_DO, "no such case, or it has no steps to run")
+    why = guards.write_policy_refusal(case, ctx.project)
+    if why is not None:
+        raise _Refused(RefusalClass.WRITE_POLICY, why)
+    guards.live_case_approval(ctx.store, ctx.project, case)
+    with ctx.open_session(None) as session:
+        result = _scrubbed(ctx, execute.run_case(case, session))
+    ctx.store.save_result(ctx.run_id, result)
+    return ToolOutcome(tool="run_case", ok=True, artifact_ref=f"result:{case.id}",
+                       summary=f"outcome {result.outcome.value}"
+                               + (f": {result.error}" if result.error else ""))
+
+
+def _get_persona(ctx: AgentContext, _args: EmptyArgs) -> ToolOutcome:
+    persona = ctx.store.load_portal_persona()
+    if persona is None:
+        raise _Refused(RefusalClass.NOTHING_TO_DO, "no portal persona yet; a crawl builds one")
+    return ToolOutcome(tool="get_persona", ok=True, artifact_ref=f"persona:{persona.project}",
+                       summary=f"{len(persona.screens)} screens, "
+                               f"{len(persona.taught_flows)} flows, {len(persona.gotchas)} gotchas")
+
+
+def _get_catalog(ctx: AgentContext, _args: EmptyArgs) -> ToolOutcome:
+    cat = catalog.catalog(ctx.project, ctx.store.load_flowspec(), ctx.store)
+    runnable = sum(1 for e in cat.entries if e.runnable)
+    return ToolOutcome(tool="get_catalog", ok=True, artifact_ref=f"catalog:{cat.project}",
+                       summary=f"{runnable} of {len(cat.entries)} case classes runnable")
+
+
+def _grade_case(ctx: AgentContext, args: GradeCaseArgs) -> ToolOutcome:
+    case = ctx.store.get_case(args.case_id)
+    rubric = ctx.store.load_rubric(case.rubric_ref) if case and case.rubric_ref else None
+    result = next((r for r in ctx.store.load_results(ctx.run_id) if r.case_id == args.case_id),
+                  None)
+    if case is None or rubric is None or result is None:
+        raise _Refused(RefusalClass.NOTHING_TO_DO, "needs a stored case, its rubric and a result")
+    verdict = grade.grade(rubric, result, ctx.run_id, ctx.judge, ctx.docs,
+                          run_dir=ctx.store.paths.run_dir(ctx.run_id), secrets=ctx.secrets,
+                          redactor=ctx.secrets.redactor())
+    ctx.store.save_verdict(ctx.run_id, verdict)
+    return ToolOutcome(tool="grade_case", ok=True, artifact_ref=f"verdict:{case.id}",
+                       summary=f"{verdict.result.value}: {verdict.scoreboard}")
+
+
+_HANDLERS: dict[Name, Callable[[AgentContext, Any], ToolOutcome]] = {
+    Name.CRAWL: _crawl, Name.RUN_CASE: _run_case, Name.GET_PERSONA: _get_persona,
+    Name.GET_CATALOG: _get_catalog, Name.GRADE_CASE: _grade_case,
+}
+
+
+def _release(ctx: AgentContext, outcome: ToolOutcome) -> ToolOutcome:
+    """Scrub, then gate, the one thing that goes back to the model (AL6)."""
+    clean = outcome.model_copy(update={"summary": ctx.secrets.redactor().scrub(outcome.summary)})
+    try:
+        guards.guard_model_bound(ctx.secrets, clean.model_dump_json())
+    except ValueError:
+        return _refusal(outcome.tool, RefusalClass.SECRET,
+                        "result withheld: it carried a credential")
+    return clean
+
+
+def _validate(name: str, raw_args: dict[str, Any]) -> tuple[Name, BaseModel]:
+    try:
+        tool = Name(name)
+    except ValueError:
+        raise _Refused(RefusalClass.UNKNOWN_TOOL, "no such tool") from None
+    try:
+        return tool, _ARGS[tool](**raw_args)
+    except ValidationError as exc:  # type + location only: pydantic's text would echo the input
+        bad = "; ".join(f"{'.'.join(map(str, e['loc']))}: {e['type']}" for e in exc.errors())
+        raise _Refused(RefusalClass.BAD_ARGUMENTS, f"invalid arguments ({bad})") from None
+
+
+def dispatch(ctx: AgentContext, name: str, raw_args: dict[str, Any]) -> ToolOutcome:
+    """Run one model-requested tool call. A refusal is returned, never raised."""
+    try:
+        guards.guard_model_bound(ctx.secrets, f"{name} {raw_args!r}")
+    except ValueError:
+        return _refusal("unknown", RefusalClass.SECRET,
+                        "refused: the call carried a credential value; use {{SECRET:KEY}}")
+    known = name in {n.value for n in Name}
+    label = name if known else "unknown"
+    try:
+        tool, args = _validate(name, raw_args)
+        outcome = _HANDLERS[tool](ctx, args)
+    except _Refused as refused:
+        outcome = _refusal(label, refused.kind, refused.detail)
+    except ApprovalRequired as exc:
+        outcome = _refusal(label, RefusalClass.APPROVAL, str(exc))
+    return _release(ctx, outcome)
diff --git a/src/autotester/schema/agent_layer.py b/src/autotester/schema/agent_layer.py
new file mode 100644
index 00000000..fc2db520
--- /dev/null
+++ b/src/autotester/schema/agent_layer.py
@@ -0,0 +1,94 @@
+"""The shapes the lead tester's tool surface speaks (T-179, D-042): which tools exist,
+what a model may pass each, and how a refusal is named.
+
+A model supplies IDS and bounds only (`CrawlArgs`, `RunCaseArgs`, ...). The project, the
+browser session, the judge provider and the approvals are the trusted context
+(`agents/context.py`) and have no field here, so a prompt cannot choose or widen them.
+Every args model forbids unknown fields: an invented parameter fails before any action.
+"""
+
+from __future__ import annotations
+
+from enum import StrEnum
+
+from pydantic import BaseModel, ConfigDict, Field
+
+
+class AgentToolName(StrEnum):
+    """The stage tools in this slice. `report` and `capture_network` join with the rest of T-179."""
+
+    CRAWL = "crawl"
+    RUN_CASE = "run_case"
+    GET_PERSONA = "get_persona"
+    GET_CATALOG = "get_catalog"
+    GRADE_CASE = "grade_case"
+
+
+class ToolEffect(StrEnum):
+    """What a tool can do to the outside world. T-180 allowlists subagents by this."""
+
+    READ = "read"
+    ACTING = "acting"
+    GRADING = "grading"
+
+
+class RefusalClass(StrEnum):
+    """Why a tool call produced no action. A refusal is a result, never an exception the
+    model can talk its way past (AL3)."""
+
+    UNKNOWN_TOOL = "unknown_tool"
+    BAD_ARGUMENTS = "bad_arguments"
+    SECRET = "secret"
+    APPROVAL = "approval"
+    WRITE_POLICY = "write_policy"
+    NOTHING_TO_DO = "nothing_to_do"
+
+
+class ToolSpec(BaseModel):
+    """One tool: its name, effect, and the existing function it wraps (C3)."""
+
+    model_config = ConfigDict(extra="forbid")
+
+    name: AgentToolName
+    effect: ToolEffect
+    wraps: str = Field(description="dotted path of the existing stage function the body calls")
+    description: str
+
+
+class _Args(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+
+class CrawlArgs(_Args):
+    """Bounds the model REQUESTS; the approval decides whether they are granted."""
+
+    max_actions: int | None = Field(default=None, ge=1)
+    wall_clock_s: float | None = Field(default=None, gt=0)
+    incremental: bool = False
+
+
+class RunCaseArgs(_Args):
+    case_id: str = Field(min_length=1, max_length=200)
+
+
+class GradeCaseArgs(_Args):
+    case_id: str = Field(min_length=1, max_length=200)
+
+
+class EmptyArgs(_Args):
+    """Tools that take nothing (`get_persona`, `get_catalog`): everything is trusted context."""
+
+
+class ToolOutcome(BaseModel):
+    """What a tool call returns to the model. `summary` is scrubbed before it is built, and the
+    whole outcome passes the secret gate again before it leaves the tool (AL6)."""
+
+    model_config = ConfigDict(extra="forbid")
+
+    tool: str
+    ok: bool
+    refusal: RefusalClass | None = None
+    summary: str = ""
+    artifact_ref: str | None = Field(
+        default=None, description="typed id of what the stage produced, e.g. `result:<case_id>`"
+    )
diff --git a/tests/test_agent_tools.py b/tests/test_agent_tools.py
new file mode 100644
index 00000000..35afecfb
--- /dev/null
+++ b/tests/test_agent_tools.py
@@ -0,0 +1,280 @@
+"""T-179a: the lead tester's stage tools -- thin wrappers (AL2), guards in code (AL3), no
+secret at the tool boundary (AL6). Offline: spies stand in for stages; no browser, no model."""
+
+from __future__ import annotations
+
+import importlib
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from autotester.agents import guards, tools
+from autotester.agents.context import AgentContext
+from autotester.browser.secrets import SecretStore
+from autotester.providers.mock import MockProvider
+from autotester.schema.agent_layer import AgentToolName, RefusalClass
+from autotester.schema.approval import RunApproval
+from autotester.schema.case import Case
+from autotester.schema.enums import (
+    Action,
+    ApprovalKind,
+    CaseClass,
+    CaseKind,
+    Outcome,
+    Result,
+    WritePolicy,
+)
+from autotester.schema.flowspec import Step
+from autotester.schema.project import Project, SecretRef
+from autotester.schema.run import RawResult
+from autotester.schema.verdict import Criterion, Judgment, Rubric
+from autotester.store.project_store import ProjectStore
+
+BASE = "https://app.test"
+RAW = "Hunter2-raw-value-9137"
+
+
+class Spies:
+    def __init__(self) -> None:
+        self.calls: dict[str, list[tuple[Any, ...]]] = {}
+        self.sessions = 0
+
+    def hit(self, name: str, *args: Any) -> None:
+        self.calls.setdefault(name, []).append(args)
+
+    def count(self, name: str) -> int:
+        return len(self.calls.get(name, []))
+
+
+def _project(policy: WritePolicy) -> Project:
+    return Project(slug="demo", name="Demo", base_url=BASE, allowed_domains=["app.test"],
+                   write_policy=policy,
+                   secrets=[SecretRef(key="APP_PASS", domains=["app.test"])])
+
+
+def _case(steps: list[Step], rubric: bool = False) -> Case:
+    return Case(project="demo", flow_id="f1", kind=CaseKind.BEST, case_class=CaseClass.HAPPY,
+                title="case", steps=steps, rubric_ref="r1" if rubric else None)
+
+
+def _nav() -> Step:
+    return Step(order=1, action=Action.NAVIGATE, target="/home")
+
+
+def _grant(store: ProjectStore, kind: ApprovalKind, actions: int = 50) -> None:
+    store.add_approval(RunApproval(
+        project="demo", run_kind=kind, target=BASE, scope="t179a fixture", max_actions=actions,
+        wall_clock_s=900.0, granted_by="umesh", granted_at="2026-10-01",
+        expires_at="2099-01-01").sign())
+
+
+@pytest.fixture
+def spies(monkeypatch: pytest.MonkeyPatch) -> Spies:
+    spy = Spies()
+    result = lambda case_id: RawResult(case_id=case_id, outcome=Outcome.COMPLETED)  # noqa: E731
+    monkeypatch.setattr(tools.execute, "run_case",
+                        lambda case, session: (spy.hit("run_case", case, session),
+                                               result(case.id))[1])
+    monkeypatch.setattr(tools.explore, "run_crawl",
+                        lambda *a, **k: (spy.hit("run_crawl", *a), _crawl())[1])
+    monkeypatch.setattr(tools.grade, "grade",
+                        lambda *a, **k: (spy.hit("grade", *a), _verdict(a))[1])
+    monkeypatch.setattr(tools.catalog, "catalog",
+                        lambda *a, **k: (spy.hit("catalog", *a), _catalog())[1])
+    return spy
+
+
+def _crawl() -> Any:
+    from autotester.schema.crawl import Crawl
+    return Crawl(project="demo")
+
+
+def _catalog() -> Any:
+    from autotester.schema.catalog import Catalog
+    return Catalog(project="demo")
+
+
+def _verdict(args: tuple[Any, ...]) -> Any:
+    from autotester.schema.verdict import Verdict
+    return Verdict(run_id=args[2], case_id=args[1].case_id, rubric_hash="h", result=Result.PASS,
+                   grader_provider="mock")
+
+
+def _ctx(tmp_path: Path, spy: Spies, policy: WritePolicy = WritePolicy.READ_ONLY) -> AgentContext:
+    project = _project(policy)
+    store = ProjectStore("demo", tmp_path)
+    store.paths.ensure()
+    store.save_project(project)
+
+    def open_session(observer: object) -> Any:
+        spy.sessions += 1
+        return _Session()
+    return AgentContext(project=project, store=store,
+                        secrets=SecretStore(project, {"APP_PASS": RAW}),
+                        judge=MockProvider(), run_id="run-1", open_session=open_session)
+
+
+class _Session:
+    def __enter__(self) -> _Session:
+        return self
+
+    def __exit__(self, *exc: object) -> None:
+        return None
+
+
+def _go(ctx: AgentContext, name: str, args: dict[str, Any] | None = None) -> Any:
+    return tools.dispatch(ctx, name, args or {})
+
+
+# -- AL2: each tool wraps its named existing function, once, with the trusted context ----------
+def test_every_tool_names_a_real_existing_function() -> None:
+    assert set(tools.TOOLS) == set(AgentToolName)
+    for spec in tools.TOOLS.values():
+        parts = spec.wraps.split(".")
+        target: Any = importlib.import_module(".".join(parts[:3]))  # autotester.<pkg>.<module>
+        for attr in parts[3:]:
+            target = getattr(target, attr)
+        assert callable(target), spec.wraps
+
+
+def test_run_case_wraps_execute_run_case_once_with_the_context_session(
+        tmp_path: Path, spies: Spies) -> None:
+    ctx = _ctx(tmp_path, spies)
+    case = ctx.store.add_case(_case([_nav()]))
+    _grant(ctx.store, ApprovalKind.LIVE_CASE)
+    out = _go(ctx, "run_case", {"case_id": case.id})
+    assert out.ok and out.artifact_ref == f"result:{case.id}"
+    assert spies.count("run_case") == 1 and spies.sessions == 1
+    assert ctx.store.load_results("run-1")[0].case_id == case.id
+
+
+def test_crawl_wraps_run_crawl_once_when_within_the_approval(tmp_path: Path, spies: Spies) -> None:
+    ctx = _ctx(tmp_path, spies)
+    _grant(ctx.store, ApprovalKind.CRAWL, actions=50)
+    out = _go(ctx, "crawl", {"max_actions": 40, "wall_clock_s": 600})
+    assert out.ok and spies.count("run_crawl") == 1
+
+
+def test_read_tools_and_grade_wrap_catalog_persona_grade(tmp_path: Path, spies: Spies) -> None:
+    ctx = _ctx(tmp_path, spies)
+    assert _go(ctx, "get_catalog").ok and spies.count("catalog") == 1
+    assert _go(ctx, "get_persona").refusal is RefusalClass.NOTHING_TO_DO
+    case = ctx.store.add_case(_case([_nav()], rubric=True))
+    ctx.store.save_rubric(Rubric(id="r1", case_id=case.id, criteria=[Criterion(id="c1", text="t")]))
+    assert _go(ctx, "grade_case", {"case_id": case.id}).refusal is RefusalClass.NOTHING_TO_DO
+    ctx.store.save_result("run-1", RawResult(case_id=case.id, outcome=Outcome.COMPLETED))
+    out = _go(ctx, "grade_case", {"case_id": case.id})
+    assert out.ok and spies.count("grade") == 1
+    assert spies.calls["grade"][0][3] is ctx.judge
+
+
+# -- AL3: guards execute inside the tool, before any browser, whatever the model says -----------
+def test_al3a_raw_secret_in_arguments_is_refused_before_any_action(
+        tmp_path: Path, spies: Spies) -> None:
+    ctx = _ctx(tmp_path, spies)
+    _grant(ctx.store, ApprovalKind.LIVE_CASE)
+    for name, args in (("run_case", {"case_id": RAW}), ("get_catalog", {"note": RAW}),
+                       ("run_case", {"case_id": "c1", "x": f"use {RAW[::-1]} reversed"})):
+        out = _go(ctx, name, args)
+        assert out.refusal is RefusalClass.SECRET and not out.ok
+        assert RAW not in out.model_dump_json()
+    assert spies.sessions == 0 and not spies.calls
+
+
+def test_al3b_crawl_beyond_the_approval_is_refused_before_a_browser_opens(
+        tmp_path: Path, spies: Spies) -> None:
+    ctx = _ctx(tmp_path, spies)
+    assert _go(ctx, "crawl").refusal is RefusalClass.APPROVAL  # no approval at all
+    _grant(ctx.store, ApprovalKind.CRAWL, actions=50)
+    out = _go(ctx, "crawl", {"max_actions": 5000})
+    assert out.refusal is RefusalClass.APPROVAL and "grant" in out.summary.lower()
+    assert spies.sessions == 0 and spies.count("run_crawl") == 0
+
+
+def test_al3c_a_read_only_project_refuses_a_mutating_step_from_the_tool_itself(
+        tmp_path: Path, spies: Spies) -> None:
+    ctx = _ctx(tmp_path, spies, WritePolicy.READ_ONLY)
+    _grant(ctx.store, ApprovalKind.LIVE_CASE)
+    fill = Step(order=1, action=Action.FILL, target="Display name", value="Eve")
+    delete = Step(order=1, action=Action.CLICK, target="Delete account")
+    for step in (fill, delete):
+        case = ctx.store.add_case(_case([_nav(), step]))
+        out = _go(ctx, "run_case", {"case_id": case.id})
+        assert out.refusal is RefusalClass.WRITE_POLICY and "read_only" in out.summary
+    assert spies.sessions == 0 and spies.count("run_case") == 0
+
+
+def test_read_only_still_allows_login_placeholder_and_the_same_step_under_test_account(
+        tmp_path: Path, spies: Spies) -> None:
+    ctx = _ctx(tmp_path, spies, WritePolicy.READ_ONLY)
+    _grant(ctx.store, ApprovalKind.LIVE_CASE)
+    login = Step(order=2, action=Action.FILL, target="Password", value="{{SECRET:APP_PASS}}")
+    assert _go(ctx, "run_case", {"case_id": ctx.store.add_case(_case([_nav(), login])).id}).ok
+    writer = _ctx(tmp_path / "w", spies, WritePolicy.TEST_ACCOUNT)
+    _grant(writer.store, ApprovalKind.LIVE_CASE)
+    fill = Step(order=2, action=Action.FILL, target="Display name", value="Eve")
+    assert _go(writer, "run_case", {"case_id": writer.store.add_case(_case([_nav(), fill])).id}).ok
+
+
+def test_run_case_without_a_live_case_approval_is_refused(tmp_path: Path, spies: Spies) -> None:
+    ctx = _ctx(tmp_path, spies)
+    case = ctx.store.add_case(_case([_nav()]))
+    assert _go(ctx, "run_case", {"case_id": case.id}).refusal is RefusalClass.APPROVAL
+    assert spies.sessions == 0
+
+
+# -- validation and AL6: unknown tools/fields, empty work, nothing secret leaves a tool ---------
+def test_unknown_tool_field_and_case_do_nothing(tmp_path: Path, spies: Spies) -> None:
+    ctx = _ctx(tmp_path, spies)
+    assert _go(ctx, "shell", {"cmd": "ls"}).refusal is RefusalClass.UNKNOWN_TOOL
+    assert _go(ctx, "run_case", {"case_id": "c", "project": "other"}).refusal \
+        is RefusalClass.BAD_ARGUMENTS
+    assert _go(ctx, "run_case", {"case_id": "missing"}).refusal is RefusalClass.NOTHING_TO_DO
+    empty = ctx.store.add_case(_case([]))
+    assert _go(ctx, "run_case", {"case_id": empty.id}).refusal is RefusalClass.NOTHING_TO_DO
+    assert not spies.calls and spies.sessions == 0
+
+
+def test_al6_a_secret_in_a_stage_result_never_reaches_the_model(
+        tmp_path: Path, spies: Spies, monkeypatch: pytest.MonkeyPatch) -> None:
+    ctx = _ctx(tmp_path, spies)
+    _grant(ctx.store, ApprovalKind.LIVE_CASE)
+    case = ctx.store.add_case(_case([_nav()]))
+    leaked = RawResult(case_id=case.id, outcome=Outcome.ERRORED, error=f"bad login {RAW}")
+    monkeypatch.setattr(tools.execute, "run_case", lambda c, s: leaked)
+    out = _go(ctx, "run_case", {"case_id": case.id})
+    assert RAW not in out.model_dump_json()
+    stored = ctx.store.paths.run_dir("run-1").joinpath(f"{case.id}.json")
+    assert RAW not in stored.read_text("utf-8")
+
+
+def test_al6_a_stage_summary_is_scrubbed_and_a_folded_secret_withholds_the_result(
+        tmp_path: Path, spies: Spies, monkeypatch: pytest.MonkeyPatch) -> None:
+    from autotester.schema.agent_layer import ToolOutcome
+    ctx = _ctx(tmp_path, spies)
+    name = AgentToolName.GET_CATALOG
+    monkeypatch.setitem(tools._HANDLERS, name, lambda c, a: ToolOutcome(
+        tool="get_catalog", ok=True, summary=f"typed {RAW} into the form"))
+    out = _go(ctx, "get_catalog")
+    assert out.ok and RAW not in out.model_dump_json()  # exact value: scrubbed to a placeholder
+    monkeypatch.setitem(tools._HANDLERS, name, lambda c, a: ToolOutcome(
+        tool="get_catalog", ok=True, summary=f"typed {RAW[::-1]} into the form"))
+    folded = _go(ctx, "get_catalog")
+    assert folded.refusal is RefusalClass.SECRET and RAW[::-1] not in folded.model_dump_json()
+
+
+def test_al6_a_real_grade_withholds_a_prompt_carrying_a_secret(tmp_path: Path) -> None:
+    ctx = _ctx(tmp_path, Spies())
+    ctx.judge = MockProvider(responses={"judge": [Judgment(result=Result.PASS)]})
+    case = ctx.store.add_case(_case([_nav()], rubric=True))
+    ctx.store.save_rubric(Rubric(id="r1", case_id=case.id,
+                                 criteria=[Criterion(id="c1", text=f"mentions {RAW}")]))
+    ctx.store.save_result("run-1", RawResult(case_id=case.id, outcome=Outcome.COMPLETED))
+    out = _go(ctx, "grade_case", {"case_id": case.id})
+    assert ctx.judge.prompts == [] and RAW not in out.model_dump_json()  # type: ignore[attr-defined]
+    assert ctx.store.load_verdicts("run-1")[0].result is Result.BLOCKED
+
+
+def test_guards_module_exposes_the_write_policy_check_as_a_pure_function() -> None:
+    assert guards.write_policy_refusal(_case([_nav()]), _project(WritePolicy.READ_ONLY)) is None
