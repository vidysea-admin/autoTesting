# Optional HTTPS front for docker/compose.prod.yml (profile "https"). Caddy fetches and renews
# the certificate for {$AUTOTESTER_DOMAIN} itself; ports 80 and 443 must reach this host.
{$AUTOTESTER_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# Video uploads: the proxy limit must be at least AUTOTESTER_MAX_UPLOAD_BYTES (HO31).
	request_body {
		max_size {$AUTOTESTER_MAX_UPLOAD_BYTES}
	}

	# The live browser view is only for signed-in people holding live.view (HO12). The proxy
	# keeps no list of its own: it asks the app (GET /auth/check), which answers 401/302 without
	# a session, 403 without live.view, and 200 with the identity. Browsers and the websocket
	# upgrade both carry the session cookie, so both are checked. Sending input is limited by
	# the viewer URL's view_only=1 for anyone without live.control (see docker/DEPLOY.md).
	handle /novnc/* {
		forward_auth autotester:8000 {
			uri /auth/check
		}
		uri strip_prefix /novnc
		reverse_proxy autotester:6080
	}

	handle {
		reverse_proxy autotester:8000
	}
}
