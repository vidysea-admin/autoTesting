# Optional HTTPS front for docker/compose.prod.yml (profile "https"). Caddy fetches and renews
# the certificate for {$AUTOTESTER_DOMAIN} itself; ports 80 and 443 must reach this host.
{$AUTOTESTER_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# Video uploads: the proxy limit must be at least AUTOTESTER_MAX_UPLOAD_BYTES (HO31).
	request_body {
		max_size {$AUTOTESTER_MAX_UPLOAD_BYTES}
	}

	# The live browser view is gated per endpoint, by the app, from the session (HO12). The proxy
	# keeps no list of its own: it asks GET /auth/check, which answers 401/302 without a session,
	# 403 without live.view, and (need=control) 403 without live.control. Two upstreams exist:
	#   /novnc-view/* -> websockify 6081 -> x11vnc -viewonly (input dropped by the VNC server)
	#   /novnc/*      -> websockify 6080 -> x11vnc with input, only for live.control holders
	# A viewer who hand-builds a client against /novnc/ is refused here (403); one who uses
	# /novnc-view/ can watch but the upstream ignores every key and click. Anything else under
	# the VNC names is denied; the websocket upgrade carries the session cookie, so it is checked.
	handle /novnc-view/* {
		forward_auth autotester:8000 {
			uri /auth/check?need=view
		}
		uri strip_prefix /novnc-view
		reverse_proxy autotester:6081
	}

	handle /novnc/* {
		forward_auth autotester:8000 {
			uri /auth/check?need=control
		}
		uri strip_prefix /novnc
		reverse_proxy autotester:6080
	}

	# Bare or look-alike VNC paths (/novnc, /novnc-view, /websockify, /vnc.html): never the app.
	@vnc_other path /novnc /novnc-view /websockify* /vnc.html /vnc_lite.html
	handle @vnc_other {
		respond "Forbidden" 403
	}

	handle {
		reverse_proxy autotester:8000
	}
}
