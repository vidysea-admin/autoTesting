# Credentials — never committed, under any project
**/.env
**/.env.*
!**/.env.example

# Persistent browser profiles hold live logged-in sessions
profiles/

# Scratch, evidence, logs. Nothing here is a deliverable.
.work/

# Playwright MCP tool scratch (screenshots/console logs from live browser sessions)
.playwright-mcp/

# Pre-compact session handoff notes -- ephemeral, session-scoped, not project state
.handoffs/

# Run artifacts: screenshots and traces may contain product data
projects/*/runs/

# Lazily-generated default rubrics (stages/run_case_pipeline.py) -- derived
# state, same as runs/, not a deliverable to hand-commit per project
projects/*/rubrics/

# Video chunks and extracted frames (host-side media prep, Track A/D-014) --
# large binary derived state, regenerable from the registered source
projects/*/sources/*/chunks/
projects/*/sources/*/frames/
# Uploaded source originals can contain private product data. They are local
# inputs like browser profiles, never repository deliverables.
projects/*/sources/*/recording.*

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# OS
Thumbs.db
.DS_Store

# Crawl artifacts: screenshots of a real product under test
projects/*/crawl/*/shots/
# The rest of a crawl too, added 2026-09-09. D-015 gitignored only `shots/`, on the
# assumption a crawl artifact is a readable local record. The first crawl of a REAL
# product (Pathlynks, logged in) showed crawl.json and frontier.json carry that
# product's internal screen structure and URLs -- and this repo is PUBLIC. A crawl of
# the local fixture site is harmless; the rule cannot tell them apart, so it defaults
# to not publishing either.
projects/*/crawl/*/crawl.json
projects/*/crawl/*/frontier.json
projects/*/crawl/*/nodes.jsonl
projects/*/crawl/*/edges.jsonl
projects/*/crawl/*/issues.jsonl

# Landplane recovery 2026-09-21 (D-030): runtime residue that must not go public.
# .codex/ = another agent tool's local hook config; T-161's checked-PASS manifest
# already classifies it a runtime artifact.
.codex/
# Per-source trees derive from private recordings: transcript/observations are the
# tester's own words and product internals -- the standing rule bars them from the
# public repo (same class as recording.*/chunks/frames above).
projects/*/sources/
# Source registries can carry the person recorded (erp labels name the trainer).
projects/*/sources.jsonl
# Explorer outputs on a real product: internal screen structure + issues found
# (same rationale as the crawl artifacts above, D-015).
projects/*/screenmap.json
projects/*/issues.jsonl

# maker-checker parallel wave worktrees (AIOS /maker convention)
.worktrees/
.claude/settings.json.bak-*
HANDOFF.md
