# AutoTester credentials — ONE file for the whole repo, at the repo root.
# Copy to `.env` (gitignored). Keys are namespaced per project and must be
# declared in that project's `project.json` `secrets[]` with a domain scope;
# a project can only ever resolve the keys it declares. Everything in this
# file is masked from logs, prompts, and artifacts whether declared or not.
#
# Values never reach a model. Steps carry `{{SECRET:KEY}}` placeholders and the
# real value is substituted only at the moment of typing into an allowed host.
#
# NEVER put a real value in THIS file — it is the committed, public template.
# Real values go only in `.env` (gitignored).

# --- Pathlynks (first target) -------------------------------------------
# Use TEST accounts. write_policy stays read_only until explicitly changed.
# Two roles observed: a counsellor account and a student/user account (the
# same user account works for both vidysea and pathlynks).
PATHLYNKS_COUNSELLOR_LOGIN_URL=
PATHLYNKS_COUNSELLOR_EMAIL=
PATHLYNKS_COUNSELLOR_PASSWORD=
PATHLYNKS_USER_LOGIN_URL=
PATHLYNKS_USER_EMAIL=
PATHLYNKS_USER_PASSWORD=
# Read-only or staging URI. Used for backend assertions, never writes.
PATHLYNKS_MONGO_URI=

# --- Model providers -----------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Consent signing (AT-110) --------------------------------------------
# Signs every RunApproval (uv run autotester approve / the UI grant form) with
# an HMAC so a widened row can't be re-minted by anyone without this key —
# tamper EVIDENCE (the content-addressed id) becomes tamper PROOFING against
# anyone who doesn't hold it. A random 32+ byte string, e.g.
# `python -c "import secrets;print(secrets.token_hex(32))"`. Never share it,
# log it, or put it in a prompt. Rotating it makes every existing approval
# unverifiable (they must be re-granted) — see qa/gates/at110-approval-forgery.md.
AUTOTESTER_APPROVAL_KEY=

# === Hosted server (T-203; qa/contracts/hosting.md HO9) =================
# KEYS ONLY: every value below is empty or a harmless default. On a server the real values go in
# /etc/autotester/server.env (see docker/DEPLOY.md), never in this committed file.

# --- Where the server answers (REQUIRED once hosted) ----------------------
# The Host allow-list (AT-758) and Origin guard (D-066) return 403 for any host not listed.
# Comma or space separated, scheme + host (+ port), e.g. the server's public URL.
AUTOTESTER_ALLOWED_HOSTS=
AUTOTESTER_ALLOWED_ORIGINS=

# --- Run queue and uploads (D-072 G6) --------------------------------------
# Server-wide number of runs at once (1-64, default 2). An admin-saved value (Settings page) wins
# over this; one project never has two runs at a time whatever this says.
AUTOTESTER_MAX_CONCURRENT_RUNS=2
# Largest accepted video upload in bytes (1 MiB - 64 GiB, default 2 GiB). Keep the reverse
# proxy's body limit at least this large.
AUTOTESTER_MAX_UPLOAD_BYTES=2147483648

# --- Data root and live view -----------------------------------------------
# Folder holding projects/, profiles/, .env and .work/ (the docker image sets /data).
AUTOTESTER_ROOT=
# URL the "Live" page embeds for the noVNC viewer. Empty = http://localhost:6080 (dev only);
# behind HTTPS set a same-origin path such as /novnc/vnc.html?autoconnect=1&resize=scale
AUTOTESTER_NOVNC_URL=
# Virtual display size inside the container (default 1600x1000x24).
AUTOTESTER_SCREEN=
# Pads every browser action by this many ms for a live watch-through (0 = full speed).
AUTOTESTER_SLOW_MO_MS=0

# --- Accounts and sign-in (T-204; the keys are listed here so the file stays complete) --------
# 1 on a hosted server: sign-in required, cookies marked Secure.
AUTOTESTER_HOSTED=
# 0 ONLY for the interim over plain http before a domain exists (see docker/DEPLOY.md).
AUTOTESTER_COOKIE_SECURE=
# Email that becomes the first administrator account.
AUTOTESTER_FIRST_ADMIN_EMAIL=
# Development only: 1 skips sign-in. Never set on a server.
AUTOTESTER_AUTH_DISABLED=

# --- Mail and schedules (Group 10 placeholders) ------------------------------
AUTOTESTER_SMTP_HOST=
AUTOTESTER_SMTP_PORT=
AUTOTESTER_SMTP_USER=
AUTOTESTER_SMTP_PASSWORD=
AUTOTESTER_SMTP_FROM=
# 1 = STARTTLS.
AUTOTESTER_SMTP_TLS=
# IANA zone name for schedules, e.g. Asia/Kolkata.
AUTOTESTER_TIMEZONE=
# Preferred model id for the AI provider (blank = provider default).
AUTOTESTER_MODEL=
