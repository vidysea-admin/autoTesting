# AutoTester credentials — ONE file for the whole repo, at the repo root.
# Copy to `.env` (gitignored). Keys are namespaced per project and must be
# declared in that project's `project.json` `secrets[]` with a domain scope;
# a project can only ever resolve the keys it declares. Everything in this
# file is masked from logs, prompts, and artifacts whether declared or not.
#
# Values never reach a model. Steps carry `{{SECRET:KEY}}` placeholders and the
# real value is substituted only at the moment of typing into an allowed host.
#
# NEVER put a real value in THIS file — it is the committed, public template.
# Real values go only in `.env` (gitignored).

# --- Pathlynks (first target) -------------------------------------------
# Use TEST accounts. write_policy stays read_only until explicitly changed.
# Two roles observed: a counsellor account and a student/user account (the
# same user account works for both vidysea and pathlynks).
PATHLYNKS_COUNSELLOR_LOGIN_URL=
PATHLYNKS_COUNSELLOR_EMAIL=
PATHLYNKS_COUNSELLOR_PASSWORD=
PATHLYNKS_USER_LOGIN_URL=
PATHLYNKS_USER_EMAIL=
PATHLYNKS_USER_PASSWORD=
# Read-only or staging URI. Used for backend assertions, never writes.
PATHLYNKS_MONGO_URI=

# --- Model providers -----------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Any-model provider (T-202, LiteLLM). Names only -- values go in `.env`.
# AUTOTESTER_MODEL picks the model for agent/judge calls, as `<vendor>/<model>`:
#   gemini/gemini-2.5-pro | anthropic/claude-sonnet-5 | openai/gpt-4o | ollama/llama3
# A project can override it per role with `litellm:<model>` in project.json.
# Vendor-native keys (GEMINI_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY) are used as usual.
AUTOTESTER_MODEL=
# For any OpenAI-compatible endpoint, name it `openai/<served-model>` and set these two.
# LITELLM_API_BASE applies to every litellm model; a self-hosted endpoint is a new
# destination for screenshots, so name it deliberately.
LITELLM_API_BASE=
LITELLM_API_KEY=
# Local Ollama: the base URL is reused as the api_base for `ollama/...` models.
OLLAMA_BASE_URL=
OPENAI_API_KEY=

# --- Consent signing (AT-110) --------------------------------------------
# Signs every RunApproval (uv run autotester approve / the UI grant form) with
# an HMAC so a widened row can't be re-minted by anyone without this key —
# tamper EVIDENCE (the content-addressed id) becomes tamper PROOFING against
# anyone who doesn't hold it. A random 32+ byte string, e.g.
# `python -c "import secrets;print(secrets.token_hex(32))"`. Never share it,
# log it, or put it in a prompt. Rotating it makes every existing approval
# unverifiable (they must be re-granted) — see qa/gates/at110-approval-forgery.md.
AUTOTESTER_APPROVAL_KEY=
