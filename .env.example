# AutoTester credentials — ONE file for the whole repo, at the repo root.
# Copy to `.env` (gitignored). Keys are namespaced per project and must be
# declared in that project's `project.json` `secrets[]` with a domain scope;
# a project can only ever resolve the keys it declares. Everything in this
# file is masked from logs, prompts, and artifacts whether declared or not.
#
# Values never reach a model. Steps carry `{{SECRET:KEY}}` placeholders and the
# real value is substituted only at the moment of typing into an allowed host.
#
# NEVER put a real value in THIS file — it is the committed, public template.
# Real values go only in `.env` (gitignored).

# --- Pathlynks (first target) -------------------------------------------
# Use TEST accounts. write_policy stays read_only until explicitly changed.
# Two roles observed: a counsellor account and a student/user account (the
# same user account works for both vidysea and pathlynks).
PATHLYNKS_COUNSELLOR_LOGIN_URL=
PATHLYNKS_COUNSELLOR_EMAIL=
PATHLYNKS_COUNSELLOR_PASSWORD=
PATHLYNKS_USER_LOGIN_URL=
PATHLYNKS_USER_EMAIL=
PATHLYNKS_USER_PASSWORD=
# Read-only or staging URI. Used for backend assertions, never writes.
PATHLYNKS_MONGO_URI=

# --- Model providers -----------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Any-model provider (T-202, LiteLLM). Names only -- values go in `.env`.
# AUTOTESTER_MODEL picks the model for agent/judge calls, as `<vendor>/<model>`:
#   gemini/gemini-2.5-pro | anthropic/claude-sonnet-5 | openai/gpt-4o | ollama/llama3
# A project can override it per role with `litellm:<model>` in project.json.
# Vendor-native keys (GEMINI_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY) are used as usual.
AUTOTESTER_MODEL=
# For any OpenAI-compatible endpoint, name it `openai/<served-model>` and set these two.
# LITELLM_API_BASE applies to every litellm model; a self-hosted endpoint is a new
# destination for screenshots, so name it deliberately.
LITELLM_API_BASE=
LITELLM_API_KEY=
# Local Ollama: the base URL is reused as the api_base for `ollama/...` models.
OLLAMA_BASE_URL=
OPENAI_API_KEY=

# --- Consent signing (AT-110) --------------------------------------------
# Signs every RunApproval (uv run autotester approve / the UI grant form) with
# an HMAC so a widened row can't be re-minted by anyone without this key —
# tamper EVIDENCE (the content-addressed id) becomes tamper PROOFING against
# anyone who doesn't hold it. A random 32+ byte string, e.g.
# `python -c "import secrets;print(secrets.token_hex(32))"`. Never share it,
# log it, or put it in a prompt. Rotating it makes every existing approval
# unverifiable (they must be re-granted) — see qa/gates/at110-approval-forgery.md.
AUTOTESTER_APPROVAL_KEY=

# === Hosted server (T-203; qa/contracts/hosting.md HO9) =================
# KEYS ONLY: every value below is empty or a harmless default. On a server the real values go in
# /etc/autotester/server.env (see docker/DEPLOY.md), never in this committed file.

# --- Where the server answers (REQUIRED once hosted) ----------------------
# ALLOWED_ORIGINS feeds the Origin guard (D-066): other origins get 403 on state-changing requests.
# ALLOWED_HOSTS feeds the Host allow-list (AT-758): a request whose Host is not loopback, the host of an
# ALLOWED_ORIGINS entry, or listed here EXACTLY (port included) gets an empty 403, on every method.
# Comma or space separated, scheme + host (+ port), e.g. the server's public URL.
AUTOTESTER_ALLOWED_HOSTS=
AUTOTESTER_ALLOWED_ORIGINS=
# PUBLIC_ORIGIN (AU20) is the one origin users open, e.g. https://qa.example.com or
# http://192.168.1.20:8000 (scheme + host [+ port], no path). REQUIRED when the server binds every
# address (--host 0.0.0.0 / ::, which is what the container does): startup refuses to run unless it
# is set and admitted by ALLOWED_HOSTS / ALLOWED_ORIGINS. In docker/compose.prod.yml it is derived
# from AUTOTESTER_DOMAIN; set it in the compose shell or its .env, not in this file.
AUTOTESTER_PUBLIC_ORIGIN=

# --- Run queue and uploads (D-072 G6) --------------------------------------
# Server-wide number of runs at once (1-64, default 2). An admin-saved value (Settings page) wins
# over this; one project never has two runs at a time whatever this says.
AUTOTESTER_MAX_CONCURRENT_RUNS=2
# Largest accepted video upload in bytes (1 MiB - 64 GiB, default 2 GiB). Keep the reverse
# proxy's body limit at least this large.
AUTOTESTER_MAX_UPLOAD_BYTES=2147483648

# --- Data root and live view -----------------------------------------------
# Folder holding projects/, profiles/, .env and .work/ (the docker image sets /data).
AUTOTESTER_ROOT=
# URL the "Live" page embeds for the noVNC viewer. Empty = http://localhost:6080 (dev only);
# behind HTTPS set a same-origin path such as /novnc/vnc.html?autoconnect=1&resize=scale
AUTOTESTER_NOVNC_URL=
# Virtual display size inside the container (default 1600x1000x24).
AUTOTESTER_SCREEN=
# Pads every browser action by this many ms for a live watch-through (0 = full speed).
AUTOTESTER_SLOW_MO_MS=0

# --- Accounts and sign-in (T-204, qa/contracts/auth.md, D-074) --------------------------------
# 1 on a hosted server: sign-in required, cookies marked Secure (needs ALLOWED_HOSTS or _ORIGINS).
AUTOTESTER_HOSTED=
# 0 ONLY for the interim over plain http before a domain exists (see docker/DEPLOY.md).
AUTOTESTER_COOKIE_SECURE=
# The one address that becomes Admin/CEO on first signup. REQUIRED on a hosted or non-loopback
# server: with it unset nobody is auto-promoted, startup prints a warning, and the first admin
# must be created with `autotester auth bootstrap-admin --email <address> --password-stdin`
# (loopback dev keeps "the first account is admin").
AUTOTESTER_FIRST_ADMIN_EMAIL=
# Session lifetime in hours (default 12).
AUTOTESTER_SESSION_HOURS=
# Folder holding the account store (users, groups, sessions). Empty = <data root>/.auth, which
# is gitignored and dockerignored. Tests only; leave empty on a server.
AUTOTESTER_AUTH_DIR=
# Development only: 1 skips sign-in. Refused on a hosted or non-loopback server.
AUTOTESTER_AUTH_DISABLED=
# Rate limits (AU5) are constants in src/autotester/auth/ratelimit.py, not settings:
#   5 failed logins per account and 20 per client address per 10 minutes (HTTP 429, Retry-After),
#   10 signups per client address per 10 minutes, at most 50,000 tracked keys.

# --- Mail and schedules (Group 10 placeholders) ------------------------------
AUTOTESTER_SMTP_HOST=
AUTOTESTER_SMTP_PORT=
AUTOTESTER_SMTP_USER=
AUTOTESTER_SMTP_PASSWORD=
AUTOTESTER_SMTP_FROM=
# Display name on the From line of report e-mail (T-201a; the address is AUTOTESTER_SMTP_FROM).
AUTOTESTER_SMTP_FROM_NAME=
# 1 = STARTTLS.
AUTOTESTER_SMTP_TLS=
# Default zone for new schedules: exactly `UTC` or `IST` (upper case; D-078, IST is the fixed +05:30,
# no DST). Blank, any other value, and lowercase `ist` / `utc` all fall back to UTC.
AUTOTESTER_TIMEZONE=
# Scheduler catch-up window in minutes (integer 1..1440, default 60): a slot missed during downtime
# fires at most one catch-up inside it, older slots are recorded `missed` (TS3). AT-920.
AUTOTESTER_SCHEDULE_GRACE_MINUTES=
# Seconds between scheduler ticks (integer 1..86400, default 60); a custom schedule shows
# "scheduler stale" after two intervals without a tick (TS7). AT-920.
AUTOTESTER_TICK_INTERVAL_S=
# --- Drive intake (T-198) -----------------------------------------------------
# Full path of the `gws` CLI the Drive fetch runs (blank = find `gws` on PATH). The login itself is
# `gws auth login` on the server; no token is ever stored here.
AUTOTESTER_GWS_BIN=
